# LLM Gateway (include /v1 suffix for OpenAI-compatible endpoints)
LLM_GATEWAY_ENDPOINT=http://localhost:8080/v1
LLM_GATEWAY_AUTH_TOKEN=your-token-here

# Backend services
SESSION_SERVICE_URL=http://localhost:8000
WORKSPACE_SERVICE_URL=http://localhost:8002

# Optional
# CHECKPOINT_DIR=/path/to/checkpoints
# APPROVAL_TIMEOUT_SECONDS=300
# LOG_LEVEL=info
# LLM_MODEL=openai/gpt-4o
# LLM_GATEWAY_HEADERS={"X-Custom-Header": "value"}

# Checkpoint / recovery
# WORKSPACE_SYNC_INTERVAL=5   # Sync to workspace every N steps (0 = disabled)

# Web search (optional — required for WebSearch tool)
# TAVILY_API_KEY=tvly-your-key-here

# HTTP/sandbox mode (only used with --transport http)
# Transport mode is set via CLI args, not env vars:
#   python -m agent_host.main --transport http --port 8080 --workspace-dir ./workspace
# Or use: make run-sandbox

# SQS sandbox mode (production — polls SQS queue for sessions)
# SQS_QUEUE_URL=http://localhost:4566/000000000000/dev-sandbox-requests
# AWS_ENDPOINT_URL=http://localhost:4566  # LocalStack endpoint
# ENVIRONMENT=dev                         # CloudWatch metric dimension
# SANDBOX_SERVICE_NAME=sandbox-workers    # CloudWatch metric dimension

# Legacy sandbox mode (debugging — explicit session ID)
# SESSION_ID=                  # Pre-assigned session ID (triggers sandbox startup)
# REGISTRATION_TOKEN=          # Token for sandbox registration validation
# SANDBOX_LOCAL_MODE=false     # true = skip ECS metadata, use localhost

# Skills
# SKILLS_DIR=                  # Override user skills directory (default: ~/.cowork/skills/)
